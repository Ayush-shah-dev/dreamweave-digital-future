# Public origin of the deployed site, no trailing slash.
# Used to build absolute URLs in sitemap.xml at build time. Set this before running
# `npm run deploy:hostinger` if the live domain is not dreamweavedigitalinfluencers.com.
VITE_SITE_URL=https://dreamweavedigitalinfluencers.com

# Supabase project (auth, database, storage — see supabase/README.md for setup).
# Both are safe to expose in the browser bundle: access is enforced by Postgres Row Level
# Security, not by keeping this key secret. Never put a service-role/secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older Supabase projects call this key "anon" instead of "publishable" — VITE_SUPABASE_ANON_KEY
# is accepted as a fallback if VITE_SUPABASE_PUBLISHABLE_KEY isn't set, but prefer the name above.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Shows demo admin credentials on the /admin/login screen. Only ever takes effect in a local
# `npm run dev` session (import.meta.env.DEV) — it is always off in production builds no matter
# what this is set to, and it never grants real access, so leave it false unless you're testing
# the login UI without a Supabase project configured.
VITE_ADMIN_DEMO_MODE=false

# Skips the /admin/login redirect so the dashboard shell renders without a real Supabase
# session. Same production-safety gate as VITE_ADMIN_DEMO_MODE above (import.meta.env.DEV only)
# — but this does NOT bypass Postgres Row Level Security, which is enforced server-side. With
# this on and no real signed-in admin, admin-only tables (leads, draft blogs/testimonials) read
# back empty, not with real data. Use it to check the dashboard UI renders; sign in with a real
# admin account (see supabase/README.md) to see real data.
VITE_ADMIN_DEV_BYPASS=false
